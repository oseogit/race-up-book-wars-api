          "name": "01 - Create Question Set",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () {\n  pm.response.to.have.status(201);\n});\n\npm.test(\"the new set has an id\", function () {\n  pm.expect(pm.response.json().question_set.set_id).to.be.a(\"number\");\n});\n\n// the requests that follow use this id\npm.collectionVariables.set(\"setId\", pm.response.json().question_set.set_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Demo-User",
                "value": "{{host}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Library Rules Quiz\",\n  \"description\": \"Temporary question set used by the Postman run.\",\n  \"subject\": \"Library Science\",\n  \"grade_level\": \"College\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/question-sets",
              "host": [
